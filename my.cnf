[mysqld]
innodb_buffer_pool_size=20M
innodb_log_buffer_size=4M
performance_schema=OFF
max_connections=5
thread_cache_size=4
tmp_table_size=8M
max_heap_table_size=8M
table_open_cache=100
query_cache_type=0
query_cache_size=0
innodb_flush_log_at_trx_commit=2
innodb_file_per_table=1
innodb_io_capacity=100
skip-name-resolve
